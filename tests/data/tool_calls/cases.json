{
 "tools": {
  "get_weather": {
   "type": "function",
   "function": {
    "name": "get_weather",
    "description": "Get the current weather for a city.",
    "parameters": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string",
       "description": "The city's name, for example Paris"
      },
      "unit": {
       "type": "string",
       "enum": [
        "celsius",
        "fahrenheit"
       ],
       "description": "The temperature unit"
      },
      "days": {
       "type": "integer",
       "description": "Forecast days, 1 to 7"
      }
     },
     "required": [
      "city"
     ]
    }
   }
  },
  "search": {
   "type": "function",
   "function": {
    "name": "search",
    "description": "Search the web, the news or papers.",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "What to search for"
      },
      "sources": {
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "web",
         "news",
         "papers"
        ]
       },
       "description": "Where to search"
      },
      "limit": {
       "type": "integer",
       "description": "The most results to return"
      },
      "safe": {
       "type": "boolean",
       "description": "Filter unsafe results"
      }
     },
     "required": [
      "query"
     ]
    }
   }
  },
  "create_event": {
   "type": "function",
   "function": {
    "name": "create_event",
    "description": "Add an event to the calendar.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "start": {
       "type": "object",
       "properties": {
        "day": {
         "type": "string",
         "description": "A weekday, for example monday"
        },
        "time": {
         "type": "string",
         "description": "HH:MM, 24-hour"
        }
       },
       "required": [
        "day",
        "time"
       ]
      },
      "attendees": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         },
         "email": {
          "type": "string"
         }
        },
        "required": [
         "name"
        ]
       }
      },
      "reminder_minutes": {
       "type": "integer",
       "description": "Minutes before the start"
      }
     },
     "required": [
      "title",
      "start"
     ]
    }
   }
  },
  "book_flight": {
   "type": "function",
   "function": {
    "name": "book_flight",
    "description": "Book a flight.",
    "parameters": {
     "type": "object",
     "$defs": {
      "airport": {
       "type": "string",
       "description": "An IATA airport code, for example CDG"
      },
      "passenger": {
       "type": "object",
       "properties": {
        "kind": {
         "type": "string",
         "enum": [
          "adult",
          "child"
         ]
        },
        "count": {
         "type": "integer"
        }
       },
       "required": [
        "kind",
        "count"
       ]
      }
     },
     "properties": {
      "origin": {
       "$ref": "#/$defs/airport"
      },
      "destination": {
       "$ref": "#/$defs/airport"
      },
      "day": {
       "type": "string",
       "description": "The departure weekday, for example monday"
      },
      "passengers": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/passenger"
       }
      }
     },
     "required": [
      "origin",
      "destination",
      "day"
     ]
    }
   }
  },
  "get_time": {
   "type": "function",
   "function": {
    "name": "get_time",
    "description": "Get the current local time."
   }
  }
 },
